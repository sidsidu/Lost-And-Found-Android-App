<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotlight_bg">

    <!-- 1. DOTTED BACKGROUND SIMULATION -->
    <!-- (Normally done with a custom drawable, standard fallback for simplicity) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.05"
        android:background="@android:color/white" />

    <!-- 2. SHINY SPOTLIGHT EFFECT -->
    <View
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_spotlight_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-50dp"/>

    <!-- 3. THE HERO CARD -->
    <!-- Glow behind the card -->
    <View
        android:id="@+id/cardGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_glow"
        app:layout_constraintTop_toTopOf="@id/spotlightCard"
        app:layout_constraintBottom_toBottomOf="@id/spotlightCard"
        app:layout_constraintStart_toStartOf="@id/spotlightCard"
        app:layout_constraintEnd_toEndOf="@id/spotlightCard"
        android:layout_margin="-4dp"
        android:alpha="0.2"/>

    <com.example.lostfound.views.SpotlightRippleCard
        android:id="@+id/spotlightCard"
        android:layout_width="340dp"
        android:layout_height="400dp"
        app:cardBackgroundColor="@color/spotlight_card_bg"
        app:cardCornerRadius="@dimen/card_radius_large"
        app:cardElevation="0dp"
        app:strokeColor="#1AFFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CARD CONTENT -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvSecLevelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY LEVEL"
                android:textColor="@color/zinc_400"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvSecLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class A"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvSecLevelLabel"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Lock Icon Badge -->
            <ImageView
                android:id="@+id/ivLockIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                app:tint="@color/scan_denied"
                android:background="@drawable/bg_icon_circle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Central Graphic (Fingerprint + Glow) -->
            <View
                android:id="@+id/fingerprintGlow"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_spotlight_glow"
                android:alpha="0.0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/ivFingerprint"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/scan_idle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Footer divider -->
            <View
                android:id="@+id/footerDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toTopOf="@id/tvBiometricScan" />

            <!-- Footer -->
            <TextView
                android:id="@+id/tvBiometricScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Biometric Scan"
                android:textColor="@color/zinc_500"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@id/tvStatusMessage"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touch to Authorize"
                android:textColor="@color/zinc_300"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Small right arrow -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_right"
                android:padding="10dp"
                app:tint="@color/zinc_400"
                android:background="@drawable/bg_icon_circle_transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.example.lostfound.views.SpotlightRippleCard>

    <!-- Instruction Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INTERACTIVE SURFACE • TAP ANYWHERE"
        android:textColor="@color/zinc_500"
        android:textSize="10sp"
        android:letterSpacing="0.2"
        android:fontFamily="monospace"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
