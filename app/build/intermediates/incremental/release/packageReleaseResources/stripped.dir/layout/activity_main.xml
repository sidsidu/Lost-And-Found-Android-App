<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — MODERNIZED Home Screen
    • Flat white header
    • Soft grey search bar
    • Fully rounded Filter chips
    • Clean spacing
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CLEAN HEADER                                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="16dp">

            <!-- App title + subtitle -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/foreground"
                android:textSize="32sp"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Find what you lost, return what you found"
                android:textColor="@color/muted_foreground"
                android:textSize="15sp" />

            <!-- Search Bar — Soft grey input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Search"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/muted_foreground" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_items"
                        android:inputType="text"
                        android:textColor="@color/foreground"
                        android:textColorHint="@color/muted_foreground"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- FILTER CHIPS                                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.LostFound.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLost"
                style="@style/Widget.LostFound.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_lost" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFound"
                style="@style/Widget.LostFound.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_found" />

        </com.google.android.material.chip.ChipGroup>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTENT: RecyclerView + Empty State + Loading          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="100dp"
                tools:listitem="@layout/item_card" />

            <!-- Loading spinner -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:alpha="0.2"
                    android:contentDescription="@string/no_items_found"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/muted_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/no_items_found"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/no_items_description"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- FAB OVERLAY MENU (Initially Hidden)                    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/fabOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:elevation="6dp"
        android:visibility="gone"
        android:alpha="0" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReportLost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="176dp"
        android:text="I lost something"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        app:backgroundTint="@color/white"
        app:icon="@android:drawable/ic_menu_help"
        app:iconTint="@color/primary"
        app:shapeAppearance="@style/ShapeSmall"
        android:elevation="8dp"
        android:visibility="gone"
        android:alpha="0"
        android:translationY="50dp"/>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReportFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="112dp"
        android:text="I found something"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        app:backgroundTint="@color/white"
        app:icon="@android:drawable/ic_menu_search"
        app:iconTint="@color/primary"
        app:shapeAppearance="@style/ShapeSmall"
        android:elevation="8dp"
        android:visibility="gone"
        android:alpha="0"
        android:translationY="50dp"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- FLOATING ACTION BUTTON                                 -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Report an item"
        android:text="Report"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        app:backgroundTint="@color/primary"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white"
        app:shapeAppearance="@style/ShapeSmall" /> <!-- ShapeSmall is now 50dp rounded -->

</androidx.coordinatorlayout.widget.CoordinatorLayout>
