<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet for FAB menu: Report Lost / Report Found -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-bold"
        android:text="Report an Item"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- Report Lost Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetReportLost"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/status_lost"
        android:fontFamily="sans-serif-medium"
        android:text="🔍  I Lost Something"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="16dp" />

    <!-- Report Found Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSheetReportFound"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/status_found"
        android:fontFamily="sans-serif-medium"
        android:text="📦  I Found Something"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="16dp" />

</LinearLayout>
