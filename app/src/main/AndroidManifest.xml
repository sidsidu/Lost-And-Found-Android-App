<?xml version="1.0" encoding="utf-8"?>
<!--
    ================================================================
    ANDROID MANIFEST — Lost & Found App
    ================================================================
    FIREBASE SETUP:
    1. Place your google-services.json in the app/ directory.
    2. Enable Firestore and Storage in the Firebase Console.
    ================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera for taking photos -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Gallery access (Android 12 and below) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Gallery access (Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Phone call permission -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LostAndFound"
        tools:targetApi="34">

        <!-- Home Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Report Lost Item -->
        <activity
            android:name=".activities.ReportLostActivity"
            android:label="@string/report_lost_item"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Report Found Item -->
        <activity
            android:name=".activities.ReportFoundActivity"
            android:label="@string/report_found_item"
            android:parentActivityName=".activities.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Item Detail -->
        <activity
            android:name=".activities.ItemDetailActivity"
            android:label="@string/item_details"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Experimental Spotlight Demo -->
        <activity 
            android:name=".activities.SpotlightDemoActivity"
            android:label="Interactive Spotlight Demo" />

        <!-- FileProvider for camera images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
